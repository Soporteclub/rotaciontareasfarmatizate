# FIX (PROC-10): .env.example so new developers know what to configure.
# Copy to .env and fill in real values. NEVER commit .env.

# ─── Database (PostgreSQL / Neon) ─────────────────────────────────
# Production runs on Neon PostgreSQL (the connection string is injected by
# Netlify via env vars, NOT stored in the repo).
# For local development, create a NEON BRANCH (dev) so the main database
# stays intact, and point DATABASE_URL at that branch's connection string.
# Example (Neon branch connection string):
# ⚠️ SECURITY (SEC-01): real credentials removed from this template.
# The live DATABASE_URL is injected by Netlify (Environment Variables) —
# never committed. If one is ever leaked, rotate it in the Neon console.
# Replace with YOUR dev-branch URL:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.c-8.us-east-1.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"
# Example (local Postgres, if you prefer Docker):
# DATABASE_URL="postgresql://farmatizate:farmatizate@localhost:5432/farmatizate?schema=public"

# Node environment
NODE_ENV="development"

# Recommended timezone (Colombia) for consistent date handling.
TZ="America/Bogota"

# Optional: override the auto-generated admin key at deploy time.
# If set, /api/admin/verify and /api/settings will validate against this value
# INSTEAD of the DB-stored key. Leave empty to use the DB key (default).
# ADMIN_KEY=""
