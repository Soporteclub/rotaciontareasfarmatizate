# FIX (PROC-10): .env.example so new developers know what to configure.
# Copy to .env and fill in real values. NEVER commit .env.

# Database URL (PostgreSQL in production; the repo's schema.prisma requires postgresql).
# Example for local dev with docker-compose:
DATABASE_URL="postgresql://farmatizate:farmatizate@localhost:5432/farmatizate?schema=public"

# Node environment
NODE_ENV="development"

# Optional: override the auto-generated admin key at deploy time.
# If set, /api/admin/verify and /api/settings will validate against this value
# INSTEAD of the DB-stored key. Leave empty to use the DB key (default).
# ADMIN_KEY=""
