// ─────────────────────────────────────────────────────────────────
// Farmatízate - Sistema de Rotación de Tareas
// Schema v2 — Nombres claros para Prisma Studio
// ─────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── CONFIGURACIÓN ──────────────────────────────────────────────

/// Settings - Configuración global de la aplicación
/// Almacena la clave admin, preferencias y flags del sistema
model Settings {
  id    String @id @default("app")
  key   String @unique                    // Clave admin para acceder a configuraciones
  value String @default("farmatizate2025") // Valor de la clave

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ─── GRUPOS ─────────────────────────────────────────────────────

/// Grupo - Piso/equipo de trabajo (Piso 1, Piso 2, etc.)
/// Cada grupo tiene sus propios empleados, reglas y asignaciones
model Group {
  id          String   @id @default(cuid())
  name        String   @unique             // "Piso 1", "Piso 2"
  description String?                      // Descripción del grupo
  taskType    String   @default("cleaning") // cleaning, kitchen, etc.
  color       String   @default("#10b981") // Color en el calendario
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees   Employee[]
  rules       Rule[]
  assignments Assignment[]
  auditLogs   AuditLog[]

  @@map("groups")
}

// ─── EMPLEADOS ──────────────────────────────────────────────────

/// Empleado - Persona que rota tareas
/// Soft delete via isActive. Nunca se borra histórico.
model Employee {
  id        String    @id @default(cuid())
  name      String                        // Nombre completo
  position  String?                       // Cargo: "Auxiliar", "Administrador"
  area      String?                       // Área: "Farmacia", "Bodega"
  groupId   String                        // Grupo al que pertenece
  isActive  Boolean   @default(true)
  joinDate  DateTime  @default(now())     // Fecha de ingreso
  leaveDate DateTime?                     // Fecha de salida (null = activo)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  group       Group            @relation(fields: [groupId], references: [id])
  assignments Assignment[]
  eligibility TaskEligibility[]

  @@index([groupId])
  @@index([isActive])
  @@map("employees")
}

// ─── REGLAS ─────────────────────────────────────────────────────

/// Regla - Define QUÉ tarea se hace QUÉ día con qué frecuencia
/// Cada regla = una tarea específica en un día específico
model Rule {
  id            String   @id @default(cuid())
  groupId       String                       // Grupo asociado
  dayOfWeek     Int                          // 0=Dom, 1=Lun, ..., 6=Sáb
  frequencyType String   @default("weekly")  // daily, weekly, monthly
  frequency     Int      @default(1)          // Cada N semanas (legacy)
  taskLabel     String                       // "Sacar Basura", "Lavar Cafetera"
  validFrom     DateTime @default(now())      // Vigencia desde
  validTo       DateTime?                     // Vigencia hasta (null = siempre)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id])

  @@unique([groupId, dayOfWeek, taskLabel])
  @@index([groupId])
  @@index([dayOfWeek])
  @@index([isActive])
  @@map("rules")
}

// ─── ASIGNACIONES ───────────────────────────────────────────────

/// Asignación - QUIÉN hace QUÉ tarea, CUÁNDO
/// Históricas se bloquean (isLocked=true) y son inmutables
model Assignment {
  id         String   @id @default(cuid())
  groupId    String                       // Grupo
  employeeId String                       // Empleado asignado
  ruleId     String?                      // Regla que generó la asignación
  date       DateTime                     // Fecha de la asignación
  taskName   String                       // Nombre de la tarea: "Sacar Basura"
  isLocked   Boolean  @default(false)     // true = histórico, no modificable
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  group    Group    @relation(fields: [groupId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([groupId, date, taskName])
  @@index([groupId, date])
  @@index([employeeId])
  @@index([isLocked])
  @@index([taskName])
  @@map("assignments")
}

// ─── ELEGIBILIDAD DE TAREAS POR EMPLEADO ───────────────────────

/// TaskEligibility - Qué tareas puede/no puede hacer cada empleado
/// Permite desactivar tareas específicas por empleado
/// (ej: alguien que no toma café no lava la cafetera)
model TaskEligibility {
  id         String  @id @default(cuid())
  employeeId String                       // Empleado
  taskName   String                       // "Sacar Basura", "Lavar Cafetera"
  isEnabled  Boolean @default(true)       // true = puede hacer la tarea

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, taskName])
  @@index([employeeId])
  @@map("task_eligibility")
}

// ─── FESTIVOS ───────────────────────────────────────────────────

/// Festivo - Días no laborales (festivos colombianos)
/// El motor de equidad salta asignaciones en días festivos
model Holiday {
  id          String   @id @default(cuid())
  date        DateTime                     // Fecha exacta del festivo
  name        String                       // "Año Nuevo", "Día del Trabajo"
  type        String   @default("national") // national, regional, local
  isRecurring Boolean  @default(true)       // true = misma fecha cada año
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, name])
  @@index([date])
  @@index([isActive])
  @@map("holidays")
}

// ─── AUDITORÍA ──────────────────────────────────────────────────

/// Auditoría - Registro de todas las modificaciones
/// QUIÉN hizo QUÉ, CUÁNDO, y QUÉ CAMBIÓ
model AuditLog {
  id         String   @id @default(cuid())
  entityType String                       // "grupo", "empleado", "regla", "asignación"
  entityId   String                       // ID de la entidad afectada
  action     String                       // "crear", "editar", "eliminar", "desactivar"
  changedBy  String?                      // Quién hizo el cambio ("admin", "system")
  changes    String?                      // JSON con antes/después
  groupId    String?                      // Grupo relacionado
  createdAt  DateTime @default(now())

  group Group? @relation(fields: [groupId], references: [id])

  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
